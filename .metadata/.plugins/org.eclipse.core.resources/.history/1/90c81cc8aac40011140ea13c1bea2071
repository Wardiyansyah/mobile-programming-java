package com.unipi.latihan5;

import android.os.Bundle;
import android.app.Activity;
import android.app.AlertDialog;
import android.content.DialogInterface;
import android.view.Menu;
import android.view.View;
import android.widget.Button;
import android.widget.EditText;
import android.widget.RadioGroup;
import android.widget.Toast;

public class MainActivity extends Activity {
	RadioGroup grpOpt;
	EditText nilai1;
	EditText nilai2;
	EditText hasil;
	int total;
	
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);
        
        nilai1 = (EditText) findViewById(R.id.txtNilai1);
        nilai2 = (EditText) findViewById(R.id.txtNilai2);
        hasil = (EditText) findViewById(R.id.txtHasil);
        Button hitung = (Button) findViewById(R.id.btnHitung);
        
        hitung.setOnClickListener(new View.OnClickListener() {
			
			@Override
			public void onClick(View arg0) {
				// TODO Auto-generated method stub
				AlertDialog.Builder pesan = new AlertDialog.Builder(MainActivity.this);
				pesan.setTitle("Hitung");
				pesan.setMessage("Apakah Anda yakin ingin menghitung?");
				
				pesan.setPositiveButton("Ya", new DialogInterface.OnClickListener() {
					
					@Override
					public void onClick(DialogInterface arg0, int arg1) {
						// TODO Auto-generated method stub
//						Toast.makeText(getApplicationContext(), "Anda memilih 'Ya'", Toast.LENGTH_LONG).show();
						int pilih = grpOpt.getCheckedRadioButtonId();
						int txtnilai1 = Integer.parseInt(nilai1.getText().toString());
						int txtnilai2 = Integer.parseInt(nilai2.getText().toString());
						
						if (pilih == R.id.optPlus) {
							total = txtnilai1 + txtnilai2;
						} else if (pilih == R.id.optMinus) {
							total = txtnilai1 - txtnilai2;
						} else if (pilih == R.id.optMultiple) {
							total = txtnilai1 * txtnilai2;
						}
						hasil.setText(String.valueOf(total));
				        
					}
				});
				
				pesan.setNegativeButton("Tidak", new DialogInterface.OnClickListener() {
					
					@Override
					public void onClick(DialogInterface arg0, int arg1) {
						// TODO Auto-generated method stub
						Toast.makeText(getApplicationContext(), "Anda memilih 'Tidak'", Toast.LENGTH_LONG).show();
					}
				});
				
				AlertDialog build = pesan.create();
				build.show();
			}
		});
        
        
        
        
        
        
        
        
        
//        BATAS AKHIR CODING
    }


    @Override
    public boolean onCreateOptionsMenu(Menu menu) {
        // Inflate the menu; this adds items to the action bar if it is present.
        getMenuInflater().inflate(R.menu.main, menu);
        return true;
    }
    
}
