package com.unipi.tugas;

import android.os.Bundle;
import android.app.Activity;
import android.view.Menu;
import android.widget.EditText;
import android.widget.RadioButton;
import android.widget.RadioGroup;
import android.widget.Toast;

public class MainActivity2 extends Activity {

	double biayaSmt=0,total=0;
	@Override
	protected void onCreate(Bundle savedInstanceState) {
		super.onCreate(savedInstanceState);
		setContentView(R.layout.activity_main2);
		
		final EditText txtNim = (EditText) findViewById(R.id.txtNim);
		final EditText txtNama = (EditText) findViewById(R.id.txtNama);
		final EditText txtSmt = (EditText) findViewById(R.id.txtSmt);
		final RadioGroup grpKelas = (RadioGroup) findViewById(R.id.grpKelas);
		final RadioButton pagi = (RadioButton) findViewById(R.id.optPagi);
		final RadioButton malam = (RadioButton) findViewById(R.id.optMalam);
		
		
		if (txtSmt.equals("1")) {
			biayaSmt = 5000000;
		} else if (txtSmt.equals("2")) {
			biayaSmt = 4750000;
		} else if (txtSmt.equals("3")) {
			biayaSmt = 4500000;
		} else if (txtSmt.equals("4")) {
			biayaSmt = 4250000;
		} else if (txtSmt.equals("5")) {
			biayaSmt = 4000000;
		} else if (txtSmt.equals("6")) {
			biayaSmt = 3750000;
		} else if (txtSmt.equals("7")) {
			biayaSmt = 3500000;
		} else if (txtSmt.equals("8")) {
			biayaSmt = 3250000;
		}
		
		grpKelas.setOnCheckedChangeListener(new RadioGroup.OnCheckedChangeListener() {
			
			@Override
			public void onCheckedChanged(RadioGroup arg0, int arg1) {
				// TODO Auto-generated method stub
				if(pagi.isChecked()) {
					biayaSmt = biayaSmt * 1;
				} else if (malam.isChecked()) {
					biayaSmt = biayaSmt * 1.25;
				} else {
					android.widget.Toast.makeText(getApplicationContext(), "Kelas harus dipilih", Toast.LENGTH_SHORT).show();
				}
			}
		});
		
	} 

	@Override
	public boolean onCreateOptionsMenu(Menu menu) {
		// Inflate the menu; this adds items to the action bar if it is present.
		getMenuInflater().inflate(R.menu.main_activity2, menu);
		return true;
	}

}
